#!/bin/sh
# Regenerate debian/dash-requirements.txt from uv.lock: the Textual (and its
# dependencies) that libtmux-easy-dash bundles. Run after 'uv lock'; CI fails
# if the file is out of date. libtmux, psutil and packaging come from apt.
set -e
cd "$(dirname "$0")/.."
{
    echo "# Generated by debian/update-dash-requirements from uv.lock. Do not edit."
    uv export --frozen --no-dev --extra dash --no-emit-project --no-header --no-annotate \
        --no-emit-package libtmux --no-emit-package psutil --no-emit-package packaging
} > debian/dash-requirements.txt
